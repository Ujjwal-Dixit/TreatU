# Copy to .env for local development.
#
# On the iOS Simulator, localhost reaches your Mac directly, so the default
# below works if the backend is running locally. On a physical device or an
# Android emulator, "localhost" means the device itself — set this to your
# dev machine's LAN IP instead, e.g. http://192.168.1.23:3000/api/v1.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
