# Copy to .env for local development. Never commit the real .env file.

NODE_ENV=development
PORT=3000

# Local Postgres started via `docker compose up -d` (see docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mvp_dev?schema=public"

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-real-32+-char-secret"
JWT_REFRESH_SECRET="replace-with-a-different-32+-char-secret"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# "console" (default) logs the OTP instead of sending a real SMS — see
# ConsoleOtpSender. Set to "twilio" to send real SMS via Twilio; the three
# TWILIO_* vars below become required when you do (see backend/README.md
# for how to get a Twilio trial account set up).
OTP_SENDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

CORS_ORIGIN=*
