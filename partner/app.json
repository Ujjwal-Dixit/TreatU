{
  "expo": {
    "name": "TreatU Partner",
    "slug": "treatu-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "treatupartner",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.treatu.partner",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.treatu.partner",
      "adaptiveIcon": {
        "backgroundColor": "#0B5A30",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
